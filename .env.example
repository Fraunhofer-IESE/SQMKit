# Copy to .env and fill in what you need. Everything is optional.

# --- Git forge API keys ---------------------------------------------------
# Set either or both. Only the forge matching the repository host is used.
# GITHUB_API_KEY=
# GITLAB_API_KEY=

# --- License compliance ---------------------------------------------------
# Optional: path to a custom allow-list of license ids (one SPDX id or LicenseRef per line; blank lines and # comments are ignored).
# Defaults to the bundled list. See https://opencode.de/en/knowledge/general-conditions/standardised-open-source-licenses
# LICENSE_ALLOWLIST_PATH=

# --- Model evaluation -----------------------------------------------------
# Maximum context size in tokens for model calls.
# MODEL_CONTEXT_SIZE=32768

# Configure one or more models. Each model is a group of MODEL_<ID>_<FIELD> variables, where <ID> is any label you choose (QWEN, CLAUDE, JEV, ...).
#   PROVIDER   required: openai | anthropic | systemone
#   MODEL_NAME required
#   API_KEY    required (models without credentials are skipped)
#   BASE_URL   optional (required for systemone)
# A model is only used if it has PROVIDER, MODEL_NAME and API_KEY. Leave out any model you do not want; there is no separate "enabled" switch.

# OpenAI-compatible chat model (OpenAI, vLLM, Ollama's OpenAI API, ...)
# MODEL_QWEN_PROVIDER=openai
# MODEL_QWEN_MODEL_NAME=
# MODEL_QWEN_BASE_URL=
# MODEL_QWEN_API_KEY=

# Anthropic chat model
# MODEL_CLAUDE_PROVIDER=anthropic
# MODEL_CLAUDE_MODEL_NAME=
# MODEL_CLAUDE_API_KEY=

# Decision model over the System One API
# MODEL_JEV_PROVIDER=systemone
# MODEL_JEV_MODEL_NAME=
# MODEL_JEV_BASE_URL=
# MODEL_JEV_API_KEY=
