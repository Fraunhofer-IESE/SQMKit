# syntax=docker/dockerfile:1
FROM node:18.20.4-alpine3.20@sha256:a0b787b0d53feacfa6d606fb555e0dbfebab30573277f1fe25148b05b66fa097 AS builder

WORKDIR /app

RUN apk add --no-cache curl=8.9.1-r2

COPY package*.json ./
RUN npm ci --omit=dev

COPY . .
RUN npm run build

# Runtime stage — minimal final image
FROM node:18.20.4-alpine3.20@sha256:a0b787b0d53feacfa6d606fb555e0dbfebab30573277f1fe25148b05b66fa097

WORKDIR /app
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/node_modules ./node_modules

USER node
EXPOSE 3000
CMD ["node", "dist/index.js"]
